# Adlib API Configuration
ADLIB_USER=your_username
ADLIB_SECRET=your_password
ADLIB_START=false
ADLIB_PRIVATE=false
ADLIB_SLEEP=5000
ADLIB_SLEEP_URI=1000

# Database Configuration (SQL)
# Supports: SQLite, PostgreSQL, MySQL, MSSQL
# Examples:
# - SQLite: sqlite://./eventstream.db
# - PostgreSQL: postgresql://user:password@localhost:5432/database
# - MySQL: mysql://user:password@localhost:3306/database
DATABASE_URI=sqlite://./eventstream.db

# SQL Backend Configuration
# Set to false to disable SQL storage (use LDES only)
SQL_ENABLED=true

# LDES Configuration
# Set to true to enable LDES posting
LDES_ENABLED=false

# LDES Server URL
LDES_BASE_URL=http://localhost:9003

# LDES HTTP timeout (milliseconds)
LDES_TIMEOUT=30000

# LDES retry configuration
LDES_RETRY_ATTEMPTS=3
LDES_RETRY_DELAY=1000

# Redis Configuration
REDIS_URI=redis://localhost:6379

# Node.js Memory Configuration
MAX_NODE_MEMORY=1024

# Application Version (automatically set from package.json)
# npm_package_version=1.1.0
